# API Configuration Examples

# ── Local Development (Web on same machine) ────────────────────────────────
# For running Expo web on the same machine where Docker backend is running:
# EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# ── Local Development (Expo on physical device) ────────────────────────────
# For running Expo on a physical device/emulator accessing backend on your machine:
# Replace YOUR_MACHINE_IP with your actual IP (e.g., 192.168.1.100, 10.0.0.5)
# EXPO_PUBLIC_API_URL=http://YOUR_MACHINE_IP:8000/api/v1
# To find your IP on Windows: ipconfig | findstr "IPv4"

# ── Production ──────────────────────────────────────────────────────────────
# For production deployments:
# EXPO_PUBLIC_API_URL=https://api.bionex.com/api/v1

# ── Mock Data Mode ──────────────────────────────────────────────────────────
# Set to true ONLY when developing UI without a backend
# EXPO_PUBLIC_USE_MOCK_DATA=false
