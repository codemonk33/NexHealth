# Application Configuration
APP_NAME=Bionex API
APP_VERSION=1.0.0
DEBUG=true

# JWT Security (REQUIRED - Generate with: python scripts/generate_secrets.py)
# NEVER use these example values in production!
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_32CHAR_MINIMUM
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Sharing sessions (NFC / Bluetooth)
SHARING_TOKEN_EXPIRE_MINUTES=30

# Database (configured for Docker Compose)
DATABASE_URL=postgresql://bionex:bionex@postgres:5432/bionex

# Field-level encryption (REQUIRED - Generate with: python scripts/generate_secrets.py)
# NEVER use these example values in production!
FIELD_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY_44_CHARS_BASE64

# Redis (configured for Docker Compose)
REDIS_URL=redis://redis:6379/0

# File uploads
UPLOADS_DIR=./uploads

# CORS - comma-separated origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate limiting
RATE_LIMIT_AUTH=30/minute
RATE_LIMIT_DEFAULT=1000/minute

# ─────────────────────────────────────────────────────────────────────────────
# ENHANCED SECURITY SETTINGS
# ─────────────────────────────────────────────────────────────────────────────

# Account Lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_EXPIRY_DAYS=90
PASSWORD_REUSE_COUNT=5

# Session Management
SESSION_TIMEOUT_MINUTES=30
SESSION_TIMEOUT_DOCTOR_MINUTES=120

# IP Whitelisting for Admin (leave empty to allow all IPs)
ADMIN_IP_WHITELIST=

# ─────────────────────────────────────────────────────────────────────────────
# HASHICORP VAULT
# ─────────────────────────────────────────────────────────────────────────────
VAULT_ADDR=http://vault:8200
# VAULT_TOKEN is optional for development (uses default dev token)
# For production, MUST be provided securely
VAULT_TOKEN=
VAULT_NAMESPACE=bionex
